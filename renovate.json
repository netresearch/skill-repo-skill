{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+(?:uvx (?:\\S+ )*?[A-Za-z][A-Za-z0-9._-]*@|uv run --with [A-Za-z][A-Za-z0-9._-]*==)(?<currentValue>[0-9]\\S*)"
      ]
    }
  ]
}
